generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id    Int              @id @default(autoincrement())
  name  String
  email String?
  tasks TaskAssignee[]
}

model Direction {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  tasks    Task[]
  products Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  directionId Int
  direction   Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)
  mvpItems    MvpItem[]
  tasks       Task[]

  @@unique([name, directionId])
}

model MvpMonth {
  id         Int       @id @default(autoincrement())
  yearMonth  String    @unique
  subtitle   String    @default("")
  sortOrder  Int       @default(0)
  items      MvpItem[] @relation("MvpItemStartMonth")
  endItems   MvpItem[] @relation("MvpItemEndMonth")
}

model MvpItem {
  id          Int        @id @default(autoincrement())
  title       String
  sortOrder   Int        @default(0)
  monthId     Int
  month       MvpMonth   @relation("MvpItemStartMonth", fields: [monthId], references: [id], onDelete: Cascade)
  endMonthId  Int?
  endMonth    MvpMonth?  @relation("MvpItemEndMonth", fields: [endMonthId], references: [id], onDelete: SetNull)
  productId   Int?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  tasks       Task[]
}

model Task {
  id          Int              @id @default(autoincrement())
  title       String
  description String?          @db.Text
  startDate   DateTime?
  deadline    DateTime?
  status      String           @default("todo")
  priority    String           @default("medium")
  directionId Int?
  direction   Direction?       @relation(fields: [directionId], references: [id], onDelete: SetNull)
  productId   Int?
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  mvpItemId   Int?
  mvpItem     MvpItem?         @relation(fields: [mvpItemId], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  comments    Comment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TaskAssignee {
  id       Int    @id @default(autoincrement())
  taskId   Int
  personId Int
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([taskId, personId])
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  authorName String
  taskId     Int
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userName  String?
  createdAt DateTime @default(now())
}
